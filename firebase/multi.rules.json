{
  "rules": {
    ".read": false,
    ".write": false,

    "counter": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
    },

    "lobby": {
      ".read": "auth != null",
      "roomId": {
        ".write": "auth != null",
        ".validate": "newData.isString() && newData.val().length <= 20"
      }
    },

    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !newData.exists())",
        ".validate": "$code.matches(/^[1-9][0-9]{6}$/) && newData.isString() && newData.val().length <= 20"
      }
    },

    "rooms": {
      ".indexOn": ["createdAt"],
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && ((data.child('fullAt').exists() && data.child('fullAt').val() + 18000000 < now) || (!data.child('fullAt').exists() && data.child('createdAt').val() + 18000000 < now))",
        "createdAt": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.val() === now"
        },
        "code": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && newData.val().length <= 7"
        },
        "isPrivate": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isBoolean()"
        },
        "seats": {
          ".write": "auth != null && !data.parent().child('fullAt').exists()",
          "$uid": { ".validate": "newData.isBoolean()" }
        },
        "fullAt": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.val() === now"
        },
        "startAt": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "winnerUid": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val().beginsWith('ai_'))"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || $uid.beginsWith('ai_'))",
            "nickname": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "ready": { ".validate": "newData.isBoolean()" },
            "online": { ".validate": "newData.isBoolean()" },
            "ai": { ".validate": "newData.isBoolean() && newData.val() === $uid.beginsWith('ai_')" },
            "aiSlot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "wave": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
            "slimeLv": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "heroKey": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "minions": { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "board": { ".validate": "newData.isString() && newData.val().length <= 20000" },
            "reachedAt": { ".validate": "newData.val() === now" },
            "ended": { ".validate": "newData.isBoolean()" },
            "endedAt": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
