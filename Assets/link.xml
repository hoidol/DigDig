  <assembly fullname="Assembly-CSharp">
    <type fullname="MaxHpLevelUpStatData" preserve="all"/>
    <type fullname="FullHealLevelUStatData" preserve="all"/>
    <type fullname="BounceLevelUpStatData" preserve="all"/>
    <type fullname="AttackPowerLevelUpStatData" preserve="all"/>
  </assembly>
